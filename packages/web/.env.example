# Run on bundled fixtures with no backend. DEVELOPMENT ONLY —
# src/env.ts ignores this in a production build, because the
# daemon serves this app and /json from one origin and a shipped
# bundle quietly showing fixtures on the real tower is the
# failure this project keeps having. Against a real daemon, ask
# for a scenario with /?fake=<name> instead: the reply carries
# is_fake, so the page says it is not looking at the rack.
VITE_MOCK=1

# API base for the daemon, relative to the app origin. The daemon
# serves dist/ itself on port 3007, behind NPM/Authelia at
# example.com, so this is normally empty.
# VITE_API_BASE=

# State-feed poll interval, ms.
# VITE_POLL_MS=3000
